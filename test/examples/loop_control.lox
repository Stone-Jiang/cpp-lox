print "== while break/continue =="; // == while break/continue ==
var i = 0;
var whileSum = 0;
while (true) {
  i = i + 1;
  if (i == 2) continue;
  if (i == 5) break;
  whileSum = whileSum + i;
}
print i;                            // 5
print whileSum;                     // 8

// A continue in a for loop must execute the increment clause.
print "== for break/continue ==";   // == for break/continue ==
var forSum = 0;
for (var j = 0; j < 6; j = j + 1) {
  if (j < 3) continue;
  if (j == 5) break;
  forSum = forSum + j;
}
print forSum;                       // 7

// A break affects only the innermost loop.
print "== nested loops ==";         // == nested loops ==
var outer = 0;
var visits = 0;
while (outer < 3) {
  outer = outer + 1;
  var inner = 0;
  while (inner < 3) {
    inner = inner + 1;
    if (inner == 2) break;
    visits = visits + 1;
  }
}
print outer;                        // 3
print visits;                       // 3

// Breaking out of a nested scope must close captured locals.
fun closureAfterBreak() {
  var saved = nil;
  while (true) {
    var message = "closed after break";
    fun read() {
      return message;
    }
    saved = read;
    break;
  }
  return saved;
}
print closureAfterBreak()();        // closed after break

// Continuing out of a nested scope must also close captured locals.
fun closureAfterContinue() {
  var saved = nil;
  var pass = 0;
  while (pass < 2) {
    pass = pass + 1;
    {
      var message = "closed after continue";
      fun read() {
        return message;
      }
      if (pass == 1) {
        saved = read;
        continue;
      }
    }
  }
  return saved;
}
print closureAfterContinue()();     // closed after continue

// Infinite for loops can still terminate through break.
var foreverCount = 0;
for (;;) {
  foreverCount = foreverCount + 1;
  if (foreverCount == 2) break;
}
print foreverCount;                 // 2

print "LOOP CONTROL TESTS COMPLETED"; // LOOP CONTROL TESTS COMPLETED

