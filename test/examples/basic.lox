// Literals and printing.
print "== literals ==";            // == literals ==
print nil;                         // nil
print true;                        // true
print false;                       // false
print 123.5;                       // 123.5

// Arithmetic, precedence, unary operators, and comparisons.
print "== operators ==";           // == operators ==
print 1 + 2 * 3;                   // 7
print (1 + 2) * 3;                 // 9
print 7 / 2;                       // 3.5
print -3 + 10;                     // 7
print !false;                      // true
print 3 < 4;                       // true
print 4 <= 4;                      // true
print 5 > 3;                       // true
print 5 >= 6;                      // false
print 2 == 2;                      // true
print 2 != 3;                      // true

// Strings use + for concatenation and compare by contents.
print "craft" + " " + "language"; // craft language
print "same" == "same";            // true
print "same" != "different";       // true

// Only false and nil are false-y. Like Lua, zero and empty strings are truthy.
print "== logic ==";               // == logic ==
print !nil;                        // true
print !0;                          // false
print !"";                         // false
print nil or "fallback";           // fallback
print "left" and "right";          // right

var touched = 0;
false and (touched = 1);
true or (touched = 2);
print touched;                     // 0

// Globals, assignment, blocks, and lexical shadowing.
print "== variables ==";           // == variables ==
var value = "global";
{
  var value = "block";
  print value;                     // block
  {
    var value = "inner";
    print value;                   // inner
  }
  print value;                     // block
}
print value;                       // global
print value = "changed";           // changed
print value;                       // changed

// Conditional statements and loops.
print "== control flow ==";        // == control flow ==
if (true) print "then";            // then
if (false) print "wrong"; else print "else"; // else

var i = 0;
var whileSum = 0;
while (i < 4) {
  whileSum = whileSum + i;
  i = i + 1;
}
print whileSum;                    // 6

var forSum = 0;
for (var j = 1; j <= 4; j = j + 1) {
  forSum = forSum + j;
}
print forSum;                      // 10

// Functions, return values, recursion, and higher-order calls.
print "== functions ==";           // == functions ==
fun add(a, b) {
  return a + b;
}
print add(20, 22);                 // 42

fun fibonacci(n) {
  if (n <= 1) return n;
  return fibonacci(n - 1) + fibonacci(n - 2);
}
print fibonacci(8);                // 21

fun plusOne(n) {
  return n + 1;
}

fun applyTwice(fn, value) {
  return fn(fn(value));
}
print applyTwice(plusOne, 5);      // 7

// Closures retain and mutate captured local variables.
fun makeCounter(start) {
  var count = start;
  fun next() {
    count = count + 1;
    return count;
  }
  return next;
}

var counter = makeCounter(10);
print counter();                   // 11
print counter();                   // 12
var anotherCounter = makeCounter(0);
print anotherCounter();            // 1
print counter();                   // 13

// Classes, initializers, fields, methods, this, and bound methods.
print "== classes ==";             // == classes ==
class Point {
  init(x, y) {
    this.x = x;
    this.y = y;
  }

  sum() {
    return this.x + this.y;
  }

  move(dx, dy) {
    this.x = this.x + dx;
    this.y = this.y + dy;
    return this.sum();
  }
}

var point = Point(2, 3);
print point.x;                     // 2
print point.sum();                 // 5
point.label = "origin-ish";
print point.label;                 // origin-ish
print point.move(4, 5);            // 14

var boundSum = point.sum;
print boundSum();                  // 14

// A closure can retain this after the method returns.
class Box {
  init(value) {
    this.value = value;
  }

  getter() {
    fun get() {
      return this.value;
    }
    return get;
  }
}

var getBoxValue = Box("captured this").getter();
print getBoxValue();               // captured this

// Inheritance, inherited initialization, overriding, super, and polymorphism.
print "== inheritance ==";         // == inheritance ==
class Animal {
  init(name) {
    this.name = name;
  }

  describe() {
    return this.name + " is an animal";
  }

  kind() {
    return "animal";
  }
}

class Dog < Animal {
  describe() {
    return super.describe() + " and a dog";
  }

  kind() {
    return "dog";
  }
}

var animal = Animal("Milo");
var dog = Dog("Rex");
print animal.describe();           // Milo is an animal
print dog.name;                    // Rex
print dog.describe();              // Rex is an animal and a dog

fun printKind(value) {
  print value.kind();
}
printKind(animal);                 // animal
printKind(dog);                    // dog

var boundDescription = dog.describe;
print boundDescription();          // Rex is an animal and a dog

// The currently registered native function.
print "== native ==";              // == native ==
print clock() >= 0;                // true

print "ALL FEATURE TESTS COMPLETED"; // ALL FEATURE TESTS COMPLETED
