// Run from the project root:
//   main.exe examples/file_io.lox
//
// README.md is an existing local project file. This example only opens it
// for reading and does not modify the filesystem.

var file = open("README.md");

print file;
print file.name;
print file.mode;
print file.readable;
print file.writable;
print file.closed;
print file.size;
print typeof(file);

print file.read(80);
print file.tell();
file.seek(0);

print file.readline();

file.close();
print file.closed;
