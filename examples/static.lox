class Base {
  instanceName() {
    return "base-instance";
  }

  static label() {
    return "base-static";
  }
}

class Child < Base {
  instanceName() {
    return "child-instance";
  }
}

// Inherited static lookup is dynamic.
print Child.label();               // base-static
print Child().label();             // base-static

// Patching the superclass updates subclasses that do not override the slot.
fun patchedBaseLabel() {
  return "patched-base-static";
}
Base.label = patchedBaseLabel;
print Base.label();                // patched-base-static
print Child.label();               // patched-base-static
print Child().label();             // patched-base-static

// Patching the subclass overrides the inherited slot without affecting the base.
fun childLabel() {
  return "child-static";
}
Child.label = childLabel;
print Base.label();                // patched-base-static
print Child.label();               // child-static
print Child().label();             // child-static

// Instance-method patching overrides only the subclass slot.
fun patchedInstance() {
  return "patched-instance";
}
Child.instanceName = patchedInstance;
print Base().instanceName();       // base-instance
print Child().instanceName();      // patched-instance
