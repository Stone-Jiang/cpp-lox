__module = "Map";

fun remove_all(m, keys...) {
    for(var i=0; i<keys.len; i = i+1) {
        m.remove(keys[i]);
    }
}

fun map_filter(m, fn) {
    var err = reqBinary(fn, __module, "filter");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var result = Map();
    range(k, v: m) {
        if(fn(k, v)) {
            result[k] = v;
        }
    }
    return result;
}

fun transf_values(m, fn) {
    var err = reqUnary(fn, __module, "foreach");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    range(k, v: m) {
        m[k] = fn(v);
    }
}

fun map_any(m, fn) {
    var err = reqBinary(fn, __module, "foreach");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    range(k, v: m) {
        if(fn(k, v)) {
            return true;
        }
    }
}

fun map_all(m, fn) {
    var err = reqBinary(fn, __module, "foreach");
    if(err != nil) {
        fail TYPE, err, fn;
    }
    
    range(k, v: m) {
        if(!fn(k, v)) {
            return false;
        }
    }
    return true;
}

fun map_foldl(array, p, fn) {
    var err = reqTernary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var acc = p;
    range(k, v: m) {
        acc = fn(acc, k, v);
    }
    return acc;
}

fun map_foldr(array, p, fn) {
    var err = reqTernary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }
    
    var acc = p;
    range(k, v: m) {
        acc = fn(k, v, acc);
    }
    return acc;
}

// -----

extend "map" "remove_all" remove_all;
extend "map" "filter" map_filter;
extend "map" "transf_values" transf_values;
extend "map" "any" map_any;
extend "map" "all" map_all;
extend "map" "foldl" map_foldl;
extend "map" "foldr" map_foldr;