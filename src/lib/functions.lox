var __module;

__module = "Function";

fun reqUnary(fn, where, name) {
    var err;

    if (typeof(fn) != "fun") {
        err = where + ": " + name + "() expects a function.";
    }
    if (fn.arity != 1) {
        err = where + ": " + name + "() callback must accept exactly one argument.";
    }

    return err;
}

fun reqBinary(fn, where, name) {
    var err;

    if (typeof(fn) != "fun") {
        err = where + ": " + name + "() expects a function.";
    }
    if (fn.arity != 2) {
        err = where + ": " + name + "() callback must accept exactly two arguments.";
    }

    return err;
}

fun twice(fn, i) {
    var err = reqUnary(fn, __module, "twice");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    return fn(fn(i));
}

fun thrice(fn, i) {
    var err = reqUnary(fn, __module, "thrice");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    return fn(fn(fn(i)));
}

fun iterate(fn, p, n) {
    var err = reqUnary(fn, __module, "iterate");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var acc = p;
    var result = [];

    for (var i = 0; i < n; i = i+1) {
        result.push(acc);
        acc = fn(acc);
    }

    return result;
}

extend "function" "twice" twice;
extend "function" "thrice" thrice;
extend "function" "iterate" iterate;
