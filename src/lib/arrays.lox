__module = "Array";

fun transf(array, fn) {
    var err = reqUnary(fn, __module, "transf");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var result = [];
    for (var i = 0; i < array.len; i = i + 1) {
        result.push(fn(array[i]));
    }

    return result;
}

fun foreach(array, fn) {
    var err = reqUnary(fn, __module, "foreach");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    for (var i = 0; i < array.len; i = i + 1) {
        array[i] = fn(array[i]);
    }

    return array;
}

fun filter(array, fn) {
    var err = reqUnary(fn, __module, "foreach");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var result = [];
    for (var i = 0; i < array.len; i = i + 1) {
        if(fn(array[i])) {
            result.push(array[i]);
        }
    }
    return result;
}

fun zip(fn, array1, array2) {
    var err = reqBinary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var n;
    if (array1.len < array2.len) {
        n = array1.len;
    } 
    else {
        n = array2.len;
    }

    var result = [];
    for (var i = 0; i < n; i = i + 1) {
        result.push(fn(array1[i], array2[i]));
    }

    return result;
}

fun fill(array, n) {
    for (var i = 0; i < array.len; i = i + 1) {
        array[i] = n;
    }
}

fun foldl(array, p, fn) {
    var err = reqBinary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var acc = p;
    for (var i = 0; i < array.len; i = i + 1) {
        acc = fn(acc, array[i]);
    }
    return acc;
}

fun foldr(array, p, fn) {
    var err = reqBinary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }
    
    var acc = p;
    for (var i = array.len-1; i >= 0; i = i - 1) {
        acc = fn(array[i], acc);
    }
    return acc;
}

fun any(array, fn) {
    var err = reqUnary(fn, __module, "any");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    for (var i = 0; i < array.len; i = i + 1) {
        if (fn(array[i])) {
            return true;
        }
    }

    return false;
}

fun all(array, fn) {
    var err = reqUnary(fn, __module, "all");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    for (var i = 0; i < array.len; i = i + 1) {
        if (!fn(array[i])) {
            return false;
        }
    }
    
    return true;
}

fun find'(array, fn) {
    var err = reqUnary(fn, __module, "find'");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    for (var i = 0; i < array.len; i = i + 1) {
        if (fn(array[i])) {
            return i;
        } 
    }
}

fun rfind'(array, fn) {
    var err = reqUnary(fn, __module, "rfind'");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    for (var i = array.len-1; i >= 0; i = i - 1) {
        if (fn(array[i])) {
            return i;
        } 
    }
}

fun count'(array, fn) {
    var err = reqUnary(fn, __module, "count'");
    if(err != nil) {
        fail TYPE, err, fn;
    }

    var count = 0;
    for (var i = 0; i < array.len; i = i + 1) {
        if (fn(array[i])) {
            count = count + 1;
        }
    }
    return count;
}

fun sort'(array, cmp) {
    var err = reqBinary(fn, __module, "zip");
    if(err != nil) {
        fail TYPE, err, fn;
    }
    var n = array.len;

    for (var i = 0; i < n-1; i = i + 1) {
        for (var j = 0; j < n-1-i; j = j + 1) {
            if (cmp(array[j], array[j+1])) {
                var temp = array[j];
                array[j] = array[j+1];
                array[j+1] = temp;
            }
        }
    }
}

fun find(array, n) {
    for (var i = 0; i < array.len; i = i + 1) {
        if(array[i]==n) {
            return i;
        }
    }
    return nil;
}

fun rfind(array, n) {
    for (var i = array.len-1; i >= 0; i = i - 1) {
        if(array[i]==n) {
            return i;
        }
    }
    return nil;
}

// -----

extend "array" "transf" transf;
extend "array" "foreach" foreach;
extend "array" "filter" filter;
extend "array" "fill" fill;
extend "array" "foldl" foldl;
extend "array" "foldr" foldr;
extend "array" "any" any;
extend "array" "all" all;
extend "array" "find'" find';
extend "array" "count'" count';
extend "array" "sort'" sort';
extend "array" "find" find;
extend "array" "rfind" rfind;